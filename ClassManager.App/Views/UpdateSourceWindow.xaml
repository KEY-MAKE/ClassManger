<ui:FluentWindow x:Class="ClassManager.App.Views.UpdateSourceWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="更新源设置"
                 Width="720"
                 Height="560"
                 MinWidth="560"
                 MinHeight="440"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="更新源设置" ShowMinimize="False" ShowMaximize="False" ShowClose="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,8,20,0">
                <TextBlock Text="更新源地址（version.json）"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="SourceBox"
                                Grid.Column="0"
                                PlaceholderText="https://…/version.json 或 D:\共享\version.json"
                                TextChanged="OnSourceChanged"
                                Margin="0,0,8,0" />
                    <ui:Button Grid.Column="1"
                               Content="浏览本地文件…"
                               Icon="{ui:SymbolIcon Folder24}"
                               Click="OnBrowseClick" />
                </Grid>

                <CheckBox x:Name="AutoCheckBox"
                             Content="启动时自动检查一次更新（仅提示，不自动下载）"
                             Margin="0,12,0,0" />

                <TextBlock x:Name="IgnoreText"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,10,0,0"
                           Visibility="Collapsed" />
                <ui:Button x:Name="ClearIgnoreButton"
                           Content="取消忽略该版本"
                           Appearance="Secondary"
                           HorizontalAlignment="Left"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"
                           Click="OnClearIgnoreClick" />

                <TextBlock Text="version.json 格式"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           Margin="0,16,0,6" />
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Padding="12">
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               FontFamily="Consolas"
                               TextWrapping="Wrap">
{
  "version": "0.19",
  "url": "https://…/ClassManager.App.exe",
  "size": 82624047,
  "sha256": "可选，填了会校验",
  "notes": "本次更新说明",
  "publishedAt": "2026-10-31"
}
                    </TextBlock>
                </Border>

                <TextBlock Text="没有服务器也能用：把 version.json 和新的 exe 放在同一个共享盘 / 网盘同步目录里，这里直接填本地路径（或 file:// 路径）即可；url 写相对文件名（如 ClassManager.App.exe）会自动按同目录解析。"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <ui:Button Content="测试连接"
                               Icon="{ui:SymbolIcon PlugConnected24}"
                               Click="OnTestClick"
                               Margin="0,0,8,0" />
                    <ProgressBar x:Name="TestProgress"
                                    Width="140"
                                    Height="4"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="TestResultText"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,20">
            <ui:Button Content="保存"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Save24}"
                       Click="OnSaveClick"
                       Margin="0,0,8,0" />
            <ui:Button Content="取消" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
