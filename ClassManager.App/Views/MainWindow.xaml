<ui:FluentWindow x:Class="ClassManager.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:ClassManager.App.Views"
                 Title="班级综合管理系统"
                 Width="1400"
                 Height="800"
                 MinWidth="1024"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding TitleText}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ClassInfoPill}">
                        <TextBlock Text="{Binding ClassName}"
                                   Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ui:Button Content="{Binding ThemeButtonText}"
                               Command="{Binding ToggleThemeCommand}"
                               Appearance="Secondary"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{Binding AboutButtonText}"
                               Command="{Binding ShowAboutCommand}"
                               Appearance="Primary" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 导航区（内容由 Page 承载） -->
        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="点名系统" TargetPageType="{x:Type views:RollCallPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="People24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="座位管理" TargetPageType="{x:Type views:SeatPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Grid24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="讲评课件" TargetPageType="{x:Type views:Exam2PptPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="SlideText24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="AI 办公" TargetPageType="{x:Type views:AiOfficePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ChatSparkle24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusBarTextStyle}" />
        </Border>

        <!-- Toast 宿主 -->
        <ui:SnackbarPresenter x:Name="SnackbarHost"
                              Grid.Row="0"
                              Grid.RowSpan="3"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Right" />
    </Grid>
</ui:FluentWindow>
