<Window x:Class="ClassManager.App.Views.AiWriteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AI 写入确认"
        Width="620"
        Height="460"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="AI 请求写入本地文件"
                   Style="{StaticResource SubtitleTextStyle}"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="PathText"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ActionText"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="PreviewText"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas, Microsoft YaHei UI, monospace"
                         FontSize="12"
                         VerticalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ui:Button x:Name="AllowSessionButton"
                       Content="本次会话都允许"
                       Appearance="Secondary"
                       Click="OnAllowSessionClick"
                       ToolTip="之后不再打断，直到离开本模块"
                       Margin="0,0,8,0" />
            <ui:Button Content="拒绝"
                       Appearance="Secondary"
                       Click="OnDenyClick"
                       Margin="0,0,8,0" />
            <ui:Button Content="允许"
                       Appearance="Primary"
                       Click="OnAllowClick" />
        </StackPanel>
    </Grid>
</Window>
