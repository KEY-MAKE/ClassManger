<Window x:Class="ClassManager.App.Views.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="悬浮球"
        Width="340" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">


    <Window.Resources>
        <Style x:Key="CompassButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#0E3178" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="#FFFFFF" Stroke="#2E0E3178" StrokeThickness="1.2" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#EAF1FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#D6E4F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===== 罗盘盘面（展开时才显示） ===== -->
        <Grid x:Name="CompassLayer" Visibility="Collapsed" Opacity="0">

            <!-- 盘面：半透明白圆 + 细描边，压在球下面 -->
            <Ellipse Width="304" Height="304"
                     Fill="#F7FFFFFF"
                     Stroke="#2E0E3178"
                     StrokeThickness="1.2" />

            <!-- 内圈刻度感：细虚线环 -->
            <Ellipse Width="196" Height="196"
                     Stroke="#1A0E3178"
                     StrokeThickness="1"
                     StrokeDashArray="2 4" />

            <!-- 上：点名 -->
            <Button x:Name="BtnRollCall"
                    Style="{StaticResource CompassButtonStyle}"
                    VerticalAlignment="Top"
                    Margin="0,16,0,0"
                    ToolTip="随机点名（F9）"
                    Click="OnRollCallClick">
                <StackPanel>
                    <ui:SymbolIcon Symbol="People24" FontSize="22" HorizontalAlignment="Center" />
                    <TextBlock Text="点名" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Button>

            <!-- 右：主界面 -->
            <Button x:Name="BtnOpenMain"
                    Style="{StaticResource CompassButtonStyle}"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,0"
                    ToolTip="回到主界面（座位 / 统计都在那里）"
                    Click="OnOpenMainClick">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Grid24" FontSize="22" HorizontalAlignment="Center" />
                    <TextBlock Text="主界面" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Button>

            <!-- 下：复位 -->
            <Button x:Name="BtnReset"
                    Style="{StaticResource CompassButtonStyle}"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,16"
                    ToolTip="清空本轮点名记录（人还在，只是重新开始）"
                    Click="OnResetClick">
                <StackPanel>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="22" HorizontalAlignment="Center" />
                    <TextBlock Text="复位" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Button>

            <!-- 左：收起 -->
            <Button x:Name="BtnClose"
                    Style="{StaticResource CompassButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="16,0,0,0"
                    ToolTip="收起罗盘"
                    Click="OnCloseCompassClick">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="22" HorizontalAlignment="Center" />
                    <TextBlock Text="收起" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== 球本体（始终在中心） ===== -->
        <Grid x:Name="BallLayer"
              Width="72" Height="72"
              Cursor="Hand"
              MouseLeftButtonDown="OnBallMouseDown"
              MouseMove="OnBallMouseMove"
              MouseLeftButtonUp="OnBallMouseUp">

            <!-- 外发光 -->
            <Ellipse Width="72" Height="72" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0E3178" Offset="0.62" />
                        <GradientStop Color="#000E3178" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 主体 -->
            <Ellipse x:Name="BallBody" Width="60" Height="60">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.34,0.28" Center="0.4,0.35">
                        <GradientStop Color="#3A6FB8" Offset="0" />
                        <GradientStop Color="#1B4F8A" Offset="0.55" />
                        <GradientStop Color="#0E3178" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 高光 -->
            <Ellipse Width="22" Height="16" Fill="#66FFFFFF"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,10,14,0" />

            <!-- 内容：图标 / 学生名字 -->
            <Grid Width="60" Height="60">
                <ui:SymbolIcon x:Name="BallIcon"
                               Symbol="People24"
                               FontSize="26"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                <TextBlock x:Name="BallName"
                           Text=""
                           Visibility="Collapsed"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="56"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>

</Window>
