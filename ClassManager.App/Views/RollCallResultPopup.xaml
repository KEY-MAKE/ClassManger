<Window x:Class="ClassManager.App.Views.RollCallResultPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="点名结果"
        Width="560" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 圆角卡片 + 柔和投影：浮在 PPT 上时要能看清，又不能太抢眼 -->
        <Style x:Key="PopupCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E6EAF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="36"
                                      ShadowDepth="0"
                                      Opacity="0.28"
                                      Color="#1A1A1A" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border x:Name="Card" Style="{StaticResource PopupCardStyle}" Padding="40,28">
            <StackPanel>
                <!-- 顶部小标题：和主界面「本次点名」保持同一措辞 -->
                <TextBlock x:Name="CaptionText"
                           Text="本次点名"
                           FontFamily="微软雅黑"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#8A94A6"
                           HorizontalAlignment="Center" />

                <!-- 名字：字号拉到 120，长名字由 Viewbox 自动缩，永不溢出 -->
                <Viewbox Height="150"
                         Margin="0,10,0,0"
                         Stretch="Uniform"
                         StretchDirection="DownOnly">
                    <TextBlock x:Name="NameText"
                               Text=""
                               FontFamily="微软雅黑"
                               FontSize="120"
                               FontWeight="Bold"
                               Foreground="#0E3178"
                               TextWrapping="NoWrap" />
                </Viewbox>

                <!-- 重复点名 / 提示语（正常情况隐藏） -->
                <TextBlock x:Name="HintText"
                           Text=""
                           Visibility="Collapsed"
                           FontFamily="微软雅黑"
                           FontSize="17"
                           Foreground="#B26A00"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
