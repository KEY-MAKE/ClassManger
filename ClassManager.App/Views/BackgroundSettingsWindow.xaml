<ui:FluentWindow x:Class="ClassManager.App.Views.BackgroundSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="课件背景设置"
                 Width="760"
                 Height="560"
                 MinWidth="560"
                 MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="课件背景设置" ShowMinimize="False" ShowMaximize="False" ShowClose="False" />

        <Grid Grid.Row="1" Margin="20,8,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="SourceText"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!-- 预览区 -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />

                    <TextBlock x:Name="EmptyHint"
                               Text="尚未选择背景图"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="背景图会铺满每一页内容页；建议 16:9、浅色、低对比度，避免压住正文。"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,20">
            <ui:Button Content="选择图片…" Click="OnChooseClick" Margin="0,0,8,0" />
            <ui:Button Content="使用默认背景" Click="OnUseDefaultClick" Margin="0,0,8,0" />
            <ui:Button Content="确定" Appearance="Primary" Click="OnConfirmClick" Margin="0,0,8,0" />
            <ui:Button Content="取消" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
