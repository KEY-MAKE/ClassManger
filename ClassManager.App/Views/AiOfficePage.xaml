<Page x:Class="ClassManager.App.Views.AiOfficePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AI 办公"
      AllowDrop="True"
      DragOver="OnDragOver"
      Drop="OnDrop">
    <Page.Resources>
        <!-- 只有「用户」消息用气泡；AI / 工具 / 错误保持纯文本，靠角色标签区分 -->
        <Style x:Key="MessageBodyBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="12,9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- 关键：NavigationView 不会给 Page 限制高度（实测会把页面拉到 7744px），
         导致消息区没有滚动范围、底部输入框被推出可视区。
         这里把页面高度钉到宿主（NavigationView）的实测高度上。 -->
    <Grid x:Name="Root" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左栏：会话 + 设置 ============ -->
        <Border Grid.Column="0" Style="{StaticResource ControlPanel}" Margin="0,0,16,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="对话" Style="{StaticResource SectionHeaderTextStyle}" />
                    <ui:Button Content="新建对话"
                               Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Margin="0,4,0,8"
                               Command="{Binding NewConversationCommand}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 非编辑态 -->
                                <StackPanel Grid.Column="0"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UpdatedText}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <!-- 编辑态 -->
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding RenameDraft, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="会话名称"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                               Appearance="Transparent"
                                               Padding="4"
                                               ToolTip="重命名"
                                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                               Command="{Binding DataContext.RenameConversationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Icon="{ui:SymbolIcon Checkmark24}"
                                               Appearance="Transparent"
                                               Padding="4"
                                               ToolTip="保存名称"
                                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                               Appearance="Transparent"
                                               Padding="4"
                                               ToolTip="删除该对话"
                                               Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 工作区与权限 -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Separator Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PermissionText}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WorkspacePath}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding WorkspacePath}"
                               Margin="0,2,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:Button Content="工作区"
                                   Appearance="Secondary"
                                   Margin="0,0,6,0"
                                   Command="{Binding ChooseWorkspaceCommand}" />
                        <ui:Button Content="打开"
                                   Appearance="Secondary"
                                   Command="{Binding OpenWorkspaceCommand}" />
                    </StackPanel>
                    <CheckBox Content="全盘无确认" IsChecked="{Binding IsFullDisk}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 右栏：用量 / 消息（悬浮输入） ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding UsageText}"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,6" />

            <!-- 消息区与输入区叠在同一格：输入框「悬浮」在文字上方，永远不会被内容顶走 -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <ScrollViewer x:Name="MessageScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="False"
                              PreviewMouseWheel="OnMessagesPreviewMouseWheel">
                    <!-- 底部留出悬浮输入框的高度，最后一条消息不会被挡住 -->
                    <ItemsControl ItemsSource="{Binding Messages}" Padding="4,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding RoleLabel}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TimeText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>

                                    <!-- 思考过程 / 工具调用：默认折叠，只留三角标 -->
                                    <Expander Visibility="{Binding HasProcess, Converter={StaticResource BoolToVisibilityConverter}}"
                                              IsExpanded="{Binding IsProcessExpanded, Mode=TwoWay}"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,4">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding ProcessSummary}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Expander.Header>
                                        <StackPanel MaxWidth="640">
                                            <TextBlock Text="{Binding Reasoning}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>

                                    <Border Style="{StaticResource MessageBodyBorder}">
                                        <TextBlock Text="{Binding Content}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>

                <!-- 输入区：像 QQ / 微信那样是聊天面板的固定底栏，
                     单独占一行（Auto），消息再多也不会把它顶走 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0" ItemsSource="{Binding Attachments}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Attach24" FontSize="14" Margin="0,0,6,0"
                                                           VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayText}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" />
                                            <ui:Button Appearance="Transparent"
                                                       Padding="2"
                                                       Margin="6,0,0,0"
                                                       Icon="{ui:SymbolIcon Dismiss16}"
                                                       ToolTip="移除附件"
                                                       Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:TextBox Grid.Row="1"
                                    x:Name="InputBox"
                                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="问我任何事… 可把文件拖进本页让我读取（Enter 发送，Shift+Enter 换行）"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    Height="64"
                                    VerticalScrollBarVisibility="Auto"
                                    PreviewKeyDown="OnInputPreviewKeyDown" />

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding StatusText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="取消" Margin="0,0,8,0"
                                           IsEnabled="{Binding CanCancel}"
                                           Command="{Binding CancelCommand}" />
                                <ui:Button Content="发送"
                                           Appearance="Primary"
                                           IsEnabled="{Binding CanSend}"
                                           Command="{Binding SendCommand}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</Page>
