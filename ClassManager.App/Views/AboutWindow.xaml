<ui:FluentWindow x:Class="ClassManager.App.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="关于班级综合管理系统"
                 Width="620"
                 Height="720"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="pack://application:,,,/Assets/Class.png" Width="64" Height="64" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SoftwareName}" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource BodyTextStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 检查更新 -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="检查更新"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       VerticalAlignment="Center" />
                            <ProgressBar Width="120"
                                            Height="4"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            IsIndeterminate="True"
                                            Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Content="检查更新"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Command="{Binding CheckUpdateCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding UpdateStatusText}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding UpdateVersionText}"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UpdateMetaText}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding UpdateNotes}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <ui:Button Content="打开下载页"
                                               Icon="{ui:SymbolIcon Link24}"
                                               Appearance="Primary"
                                               ToolTip="用浏览器打开下载页面，或打开更新源所在的文件夹"
                                               Command="{Binding OpenDownloadPageCommand}"
                                               Margin="0,0,8,0" />
                                    <ui:Button Content="下载并安装"
                                               Icon="{ui:SymbolIcon ArrowDownload24}"
                                               ToolTip="由程序直接下载安装包并覆盖安装（更新源是直链时可用）"
                                               Command="{Binding DownloadUpdateCommand}"
                                               Margin="0,0,8,0" />
                                    <ui:Button Content="忽略此版本"
                                               Icon="{ui:SymbolIcon Dismiss24}"
                                               Command="{Binding IgnoreUpdateCommand}" />
                                </StackPanel>

                                <ProgressBar Value="{Binding DownloadPercent}"
                                                Maximum="100"
                                                Height="6"
                                                Margin="0,10,0,0"
                                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding DownloadPercent, StringFormat=下载中 {0}%}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding AuthorText}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ReleaseDateText}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding EmailText}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding WebsiteText}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" />

                    <TextBlock Text="软件描述:" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,14,0,4" />
                    <TextBlock Text="{Binding DescriptionText}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="主要功能:" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,14,0,4" />
                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource BodyTextStyle}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="版权声明:" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,14,0,4" />
                    <TextBlock Text="{Binding CopyrightText}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="卸载"
                       Icon="{ui:SymbolIcon Delete24}"
                       Command="{Binding UninstallCommand}"
                       Margin="0,0,8,0" />
            <ui:Button Content="关闭"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Click="OnCloseClick"
                       Appearance="Primary" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
