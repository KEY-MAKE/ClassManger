<ui:FluentWindow x:Class="ClassManager.App.Views.GapSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="间距设置"
                 Width="480"
                 Height="640"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 统一填充 -->
        <Border Grid.Row="0" Style="{StaticResource StatCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="统一填充" Style="{StaticResource SectionHeaderTextStyle}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="列间距" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="1"
                                  x:Name="ColumnAllBox"
                                  Value="8"
                                  Minimum="0"
                                  Maximum="400"
                                  SmallChange="1"
                                  SpinButtonPlacementMode="Compact" />
                    <ui:Button Grid.Column="2"
                               Content="应用到全部列"
                               Click="OnApplyAllColumns"
                               Margin="8,0,0,0" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="行间距" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                    <ui:NumberBox Grid.Column="1"
                                  x:Name="RowAllBox"
                                  Value="8"
                                  Minimum="0"
                                  Maximum="400"
                                  SmallChange="1"
                                  SpinButtonPlacementMode="Compact" />
                    <ui:Button Grid.Column="2"
                               Content="应用到全部排"
                               Click="OnApplyAllRows"
                               Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 列间隙 -->
        <TextBlock Grid.Row="1"
                   x:Name="ColumnListHeader"
                   Text="列间距"
                   Style="{StaticResource SectionHeaderTextStyle}" />
        <Border Grid.Row="2" Style="{StaticResource StatCard}" Padding="8" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ColumnList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center" />
                                <ui:NumberBox Grid.Column="1"
                                              Value="{Binding Value, Mode=TwoWay}"
                                              Minimum="0"
                                              Maximum="400"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 行间隙 -->
        <TextBlock Grid.Row="3"
                   x:Name="RowListHeader"
                   Text="行间距"
                   Style="{StaticResource SectionHeaderTextStyle}" />
        <Border Grid.Row="4" Style="{StaticResource StatCard}" Padding="8" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center" />
                                <ui:NumberBox Grid.Column="1"
                                              Value="{Binding Value, Mode=TwoWay}"
                                              Minimum="0"
                                              Maximum="400"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="确定"
                       Click="OnOk"
                       Appearance="Primary"
                       Margin="0,0,8,0" />
            <ui:Button Content="取消" Click="OnCancel" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
